    1: from dataclasses import dataclass, field
    1: import re
       
    1: from app.rag.parser.parser import ParsedSection
       
    1: _CODE_EXTENSIONS = {
           "py", "js", "ts", "tsx", "jsx", "java", "go", "rs", "c", "cpp", "h", "hpp",
           "cs", "rb", "php", "sh", "sql", "yml", "yaml", "toml", "json", "xml",
       }
       
       
    7: @dataclass
    2: class ChunkInput:
    1:     content: str
    2:     metadata: dict = field(default_factory=dict)
       
       
    1: def split_sections(sections: list[ParsedSection], file_type: str, chunk_size: int = 800, overlap: int = 80) -> list[ChunkInput]:
    2:     chunks: list[ChunkInput] = []
    4:     for section in sections:
    2:         text = section.text.strip()
    2:         if not text:
                   continue
    2:         if file_type in _CODE_EXTENSIONS:
    1:             parts = _split_code(text, chunk_size)
               else:
    1:             parts = _split_paragraphs(text, chunk_size, overlap)
   13:         for index, part in enumerate(parts, start=1):
   11:             metadata = dict(section.metadata)
   11:             metadata.update({"chunk_part": index, "file_type": file_type})
   11:             chunks.append(ChunkInput(content=part, metadata=metadata))
    2:     return chunks
       
       
    1: def _split_paragraphs(text: str, chunk_size: int, overlap: int) -> list[str]:
    3:     paragraphs = [p.strip() for p in re.split(r"\n\s*\n", text) if p.strip()]
    1:     chunks: list[str] = []
    1:     current = ""
    3:     for paragraph in paragraphs:
    2:         if len(current) + len(paragraph) + 1 <= chunk_size:
                   current = f"{current}\n{paragraph}" if current else paragraph
               else:
    2:             if current:
                       chunks.append(current)
    2:             if len(paragraph) > chunk_size:
    2:                 current = ""
    8:                 for start in range(0, len(paragraph), chunk_size - overlap):
    6:                     chunks.append(paragraph[start:start + chunk_size])
                   else:
                       current = paragraph
    1:     if current:
               chunks.append(current)
    1:     return chunks
       
       
    1: def _split_code(text: str, chunk_size: int) -> list[str]:
    1:     lines = text.splitlines()
    1:     chunks: list[str] = []
    1:     current: list[str] = []
    1:     current_size = 0
   21:     for line in lines:
   20:         line_size = len(line) + 1
   20:         if current and current_size + line_size > chunk_size:
    4:             chunks.append("\n".join(current))
    4:             current = []
    4:             current_size = 0
   20:         current.append(line)
   20:         current_size += line_size
    1:     if current:
    1:         chunks.append("\n".join(current))
    1:     return chunks
